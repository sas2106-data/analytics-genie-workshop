{
  "datasets": [
    {
      "name": "policies",
      "displayName": "Policies (diamond)",
      "queryLines": [
        "SELECT policy_number, product_line, policy_status, issue_date,\n",
        "       CAST(date_trunc('month', issue_date) AS DATE) AS issue_month,\n",
        "       CASE WHEN policy_status = 'In force' THEN 1 ELSE 0 END AS is_in_force, premium_amount\n",
        "FROM policy_diamond"
      ]
    },
    {
      "name": "certified",
      "displayName": "Certified metrics (metric view)",
      "queryLines": [
        "SELECT product_line, policy_status,\n",
        "       MEASURE(total_policies) AS total_policies, MEASURE(in_force_policies) AS in_force_policies,\n",
        "       MEASURE(in_force_rate) AS in_force_rate, MEASURE(total_premium) AS total_premium,\n",
        "       MEASURE(avg_premium) AS avg_premium\n",
        "FROM policy_metrics\nGROUP BY ALL"
      ]
    }
  ],
