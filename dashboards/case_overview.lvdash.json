{
  "datasets": [
    {
      "name": "cases",
      "displayName": "Cases (gold view)",
      "queryLines": [
        "SELECT case_id, opened_month, case_type, channel, priority, segment, region,\n",
        "       CAST(is_open AS INT) AS is_open, days_to_close, CAST(within_sla AS INT) AS within_sla\n",
        "FROM case_customer"
      ]
    },
    {
      "name": "certified",
      "displayName": "Certified metrics (metric view)",
      "queryLines": [
        "SELECT segment, region,\n",
        "       MEASURE(total_cases) AS total_cases, MEASURE(open_cases) AS open_cases,\n",
        "       MEASURE(avg_days_to_close) AS avg_days_to_close, MEASURE(sla_met_rate) AS sla_met_rate,\n",
        "       MEASURE(customers_with_cases) AS customers_with_cases\n",
        "FROM case_metrics\nGROUP BY ALL"
      ]
    }
  ],
